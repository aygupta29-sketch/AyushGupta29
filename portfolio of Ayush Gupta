<script>
  // typed query effect in hero terminal
  (function(){
    var el = document.getElementById('typedQuery');
    var text = "SELECT name, role FROM analysts\nWHERE verified = true;";
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if(reduced){
      el.textContent = text;
    } else {
      var i = 0;
      function type(){
        if(i <= text.length){
          el.innerHTML = text.slice(0,i).replace(/\n/g,'<br>') + '<span class="cursor"></span>';
          i++;
          setTimeout(type, 22);
        }
      }
      type();
    }
  })();

  // animated line-chart draw-in (signature hero element)
  (function(){
    var line = document.getElementById('chartLine');
    var area = document.getElementById('chartArea');
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if(!line) return;
    var len = line.getTotalLength();
    if(reduced){
      line.style.strokeDasharray = 'none';
      area.style.opacity = 1;
      return;
    }
    line.style.strokeDasharray = len;
    line.style.strokeDashoffset = len;
    area.style.opacity = 0;
    setTimeout(function(){
      line.style.transition = 'stroke-dashoffset 1.8s cubic-bezier(.4,0,.2,1)';
      line.style.strokeDashoffset = 0;
      area.style.transition = 'opacity 1.4s ease 0.6s';
      area.style.opacity = 1;
    }, 250);
  })();

  // pulsing endpoint dot
  (function(){
    var dot = document.querySelector('.pulse-dot');
    if(!dot) return;
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if(reduced) return;
    var r = 4.5, growing = true;
    setInterval(function(){
      r += growing ? 0.15 : -0.15;
      if(r > 6.5) growing = false;
      if(r < 4.5) growing = true;
      dot.setAttribute('r', r.toFixed(2));
    }, 40);
  })();

  // count-up stats
  (function(){
    var nums = document.querySelectorAll('.stat-num[data-count]');
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function animate(el){
      var target = parseInt(el.getAttribute('data-count'), 10);
      var suffix = el.getAttribute('data-suffix') || '';
      if(reduced){ el.textContent = target + suffix; return; }
      var start = 0, duration = 1200, startTime = null;
      function step(ts){
        if(!startTime) startTime = ts;
        var progress = Math.min((ts - startTime) / duration, 1);
        var eased = 1 - Math.pow(1 - progress, 3);
        var val = Math.floor(eased * target);
        el.textContent = val.toLocaleString() + suffix;
        if(progress < 1) requestAnimationFrame(step);
        else el.textContent = target.toLocaleString() + suffix;
      }
      requestAnimationFrame(step);
    }
    if(!('IntersectionObserver' in window)){
      nums.forEach(animate);
    } else {
      var io = new IntersectionObserver(function(entries){
        entries.forEach(function(entry){
          if(entry.isIntersecting){ animate(entry.target); io.unobserve(entry.target); }
        });
      }, {threshold:0.5});
      nums.forEach(function(n){ io.observe(n); });
    }
  })();

  // scroll reveal for project cards
  (function(){
    var cards = document.querySelectorAll('[data-reveal]');
    if(!('IntersectionObserver' in window)){
      cards.forEach(function(c){ c.classList.add('in'); });
      return;
    }
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(entry){
        if(entry.isIntersecting){
          entry.target.classList.add('in');
          io.unobserve(entry.target);
        }
      });
    }, {threshold:0.15});
    cards.forEach(function(c){ io.observe(c); });
  })();
</script>

