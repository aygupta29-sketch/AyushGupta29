<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#080D16;
    --bg-soft:#0C1420;
    --surface:#0F1826;
    --surface-hi:#141F30;
    --ink:#EAF1F7;
    --ink-soft:#9FB1C4;
    --ink-faint:#5C6E82;
    --accent:#2DE0CF;
    --accent-deep:#17B3A4;
    --accent-glow:rgba(45,224,207,0.35);
    --gold:#F0B429;
    --gold-glow:rgba(240,180,41,0.28);
    --line:#1C2A3B;
    --line-soft:#152130;
    --panel:#030609;
    --radius:16px;
    --maxw:1080px;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  @media (prefers-reduced-motion: reduce){
    html{scroll-behavior:auto;}
    *{animation-duration:0.01ms !important; animation-iteration-count:1 !important; transition-duration:0.01ms !important;}
  }
  body{
    margin:0;
    background:var(--bg);
    color:var(--ink);
    font-family:'IBM Plex Sans', sans-serif;
    line-height:1.55;
    -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
  }
  h1,h2,h3{
    font-family:'Space Grotesk', sans-serif;
    color:var(--ink);
    margin:0;
    letter-spacing:-0.01em;
  }
  .mono{font-family:'IBM Plex Mono', monospace;}
  a{color:var(--accent); text-decoration:none;}
  a:hover{text-decoration:underline;}
  :focus-visible{outline:2px solid var(--accent); outline-offset:3px; border-radius:4px;}

  .wrap{max-width:var(--maxw); margin:0 auto; padding:0 28px; position:relative;}

  /* background texture */
  .bg-grid{
    position:fixed; inset:0; z-index:0; pointer-events:none;
    background-image:
      linear-gradient(rgba(45,224,207,0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(45,224,207,0.035) 1px, transparent 1px);
    background-size:56px 56px;
    mask-image:radial-gradient(ellipse 60% 50% at 50% 0%, black 20%, transparent 75%);
  }

  /* NAV */
  nav{
    position:sticky; top:0; z-index:50;
    background:rgba(8,13,22,0.78);
    backdrop-filter:blur(10px);
    border-bottom:1px solid var(--line);
  }
  nav .wrap{display:flex; align-items:center; justify-content:space-between; height:64px;}
  .nav-name{font-family:'Space Grotesk', sans-serif; font-weight:600; font-size:1.05rem; color:var(--ink);}
  .nav-name span{color:var(--accent);}
  .nav-links{display:flex; gap:26px; font-size:0.92rem; font-weight:500;}
  .nav-links a{color:var(--ink-soft);}
  .nav-links a:hover{color:var(--accent); text-decoration:none;}

  /* HERO */
  .hero{padding:70px 0 60px; position:relative; z-index:1;}
  .hero-chart{
    position:absolute; top:20px; right:-40px; width:min(560px, 55vw); height:280px;
    opacity:0.55; pointer-events:none; z-index:0;
  }
  @media(max-width:820px){.hero-chart{display:none;}}

  .terminal{
    background:var(--panel);
    border:1px solid var(--line);
    border-radius:var(--radius);
    padding:22px 26px;
    max-width:560px;
    box-shadow:0 0 0 1px rgba(45,224,207,0.06), 0 30px 60px -30px rgba(0,0,0,0.8);
    position:relative; z-index:1;
  }
  .terminal .dots{display:flex; gap:6px; margin-bottom:16px;}
  .terminal .dots span{width:9px; height:9px; border-radius:50%; background:#1E2C3D; display:inline-block;}
  .terminal .query{color:var(--accent); font-size:0.92rem; white-space:pre-wrap;}
  .terminal .comment{color:var(--ink-faint); font-size:0.86rem; margin-top:10px;}
  .cursor{display:inline-block; width:7px; height:1em; background:var(--accent); vertical-align:text-bottom; animation:blink 1s step-end infinite;}
  @keyframes blink{50%{opacity:0;}}

  .hero-title{
    margin-top:32px; font-size:clamp(2.6rem, 5.8vw, 4rem); font-weight:700; line-height:1.05;
    position:relative; z-index:1;
  }
  .hero-role{margin-top:10px; font-size:1.18rem; color:var(--accent); font-weight:500; position:relative; z-index:1;}
  .hero-pitch{margin-top:16px; max-width:560px; color:var(--ink-soft); font-size:1.02rem; position:relative; z-index:1;}

  .hero-cta{display:flex; gap:14px; margin-top:28px; flex-wrap:wrap; position:relative; z-index:1;}
  .btn{
    font-family:'IBM Plex Sans', sans-serif; font-weight:600; font-size:0.92rem;
    padding:12px 22px; border-radius:9px; display:inline-flex; align-items:center; gap:8px;
    transition:transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
  }
  .btn:hover{text-decoration:none; transform:translateY(-2px);}
  .btn-primary{background:var(--accent); color:#04211D; box-shadow:0 0 0 1px rgba(45,224,207,0.4), 0 12px 24px -10px var(--accent-glow);}
  .btn-primary:hover{background:#4CEBDB; box-shadow:0 0 0 1px rgba(45,224,207,0.6), 0 16px 32px -10px var(--accent-glow);}
  .btn-ghost{background:transparent; color:var(--ink); border:1px solid var(--line);}
  .btn-ghost:hover{border-color:var(--accent); color:var(--accent);}

  .stat-strip{
    margin-top:48px; display:flex; gap:0; flex-wrap:wrap;
    border-top:1px solid var(--line); padding-top:24px; position:relative; z-index:1;
  }
  .stat{padding:0 30px 0 0; margin-right:30px; border-right:1px solid var(--line);}
  .stat:last-child{border-right:none;}
  .stat-num{font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:1.6rem; color:var(--ink);}
  .stat-num .unit{color:var(--accent);}
  .stat-label{font-size:0.82rem; color:var(--ink-faint); margin-top:2px;}

  /* SECTION GENERIC */
  section{padding:56px 0; position:relative; z-index:1;}
  .eyebrow{
    font-family:'IBM Plex Mono', monospace; font-size:0.78rem; color:var(--accent);
    text-transform:uppercase; letter-spacing:0.1em; margin-bottom:8px;
  }
  .section-title{font-size:1.8rem; font-weight:700;}
  .section-head{margin-bottom:32px;}
  .divider{border:none; border-top:1px solid var(--line); margin:0; position:relative; z-index:1;}

  /* ABOUT */
  .about-text{max-width:680px; color:var(--ink-soft); font-size:1.04rem;}

  /* PROJECTS */
  .project-grid{display:grid; grid-template-columns:1fr 1fr; gap:26px;}
  @media(max-width:820px){.project-grid{grid-template-columns:1fr;}}
  .card{
    background:var(--surface); border:1px solid var(--line); border-radius:var(--radius);
    overflow:hidden; display:flex; flex-direction:column;
    opacity:0; transform:translateY(20px);
    transition:opacity 0.7s ease, transform 0.7s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }
  .card.in{opacity:1; transform:translateY(0);}
  .card:hover{border-color:rgba(45,224,207,0.4); box-shadow:0 20px 50px -25px rgba(45,224,207,0.25);}
  .card-media{aspect-ratio:16/9.4; background:#050A12; overflow:hidden; position:relative; border-bottom:1px solid var(--line);}
  .card-media img{width:100%; height:100%; object-fit:cover; display:block; transition:transform 0.5s ease;}
  .card:hover .card-media img{transform:scale(1.035);}
  .card-body{padding:24px 24px 26px; display:flex; flex-direction:column; gap:13px; flex:1;}
  .card-top{display:flex; justify-content:space-between; align-items:baseline; gap:10px;}
  .card-title{font-family:'Space Grotesk',sans-serif; font-weight:600; font-size:1.18rem;}
  .card-date{font-size:0.78rem; color:var(--ink-faint); white-space:nowrap; font-family:'IBM Plex Mono',monospace;}
  .tech-tags{display:flex; flex-wrap:wrap; gap:6px;}
  .tag{
    font-family:'IBM Plex Mono',monospace; font-size:0.72rem; padding:3px 9px;
    background:rgba(45,224,207,0.08); color:var(--accent); border-radius:20px; border:1px solid rgba(45,224,207,0.25);
  }
  .card-list{margin:0; padding-left:18px; color:var(--ink-soft); font-size:0.92rem; display:flex; flex-direction:column; gap:6px;}
  .metrics{display:flex; flex-wrap:wrap; gap:8px; margin-top:2px;}
  .metric-badge{
    font-family:'IBM Plex Mono',monospace; font-size:0.72rem; color:var(--gold);
    background:rgba(240,180,41,0.08); border:1px solid rgba(240,180,41,0.3); padding:3px 8px; border-radius:6px;
  }
  .metric-badge::before{content:"✓ "; opacity:0.85;}
  .card-foot{margin-top:auto; padding-top:6px;}
  .card-foot a{font-weight:600; font-size:0.9rem; display:inline-flex; align-items:center; gap:5px; color:var(--accent);}

  /* EXPERIENCE */
  .exp-item{display:flex; gap:20px; padding:18px 0; border-bottom:1px solid var(--line);}
  .exp-item:last-child{border-bottom:none;}
  .exp-date{font-family:'IBM Plex Mono',monospace; font-size:0.8rem; color:var(--ink-faint); min-width:140px;}
  .exp-body h3{font-size:1.02rem; font-weight:600;}
  .exp-body a{color:var(--accent); font-size:0.85rem;}
  .exp-body ul{margin:10px 0 0; padding-left:18px; color:var(--ink-soft); font-size:0.92rem; display:flex; flex-direction:column; gap:5px;}

  /* SKILLS */
  .skill-group{margin-bottom:22px;}
  .skill-group-label{font-family:'IBM Plex Mono',monospace; font-size:0.78rem; color:var(--ink-faint); margin-bottom:10px; text-transform:uppercase; letter-spacing:0.06em;}
  .skill-tags{display:flex; flex-wrap:wrap; gap:8px;}
  .skill-pill{
    font-size:0.88rem; padding:8px 15px; border-radius:8px;
    background:var(--surface); border:1px solid var(--line); color:var(--ink);
    transition:border-color 0.2s ease, color 0.2s ease;
  }
  .skill-pill:hover{border-color:var(--accent); color:var(--accent);}

  /* CERTS */
  .cert-item{display:flex; justify-content:space-between; align-items:center; padding:17px 0; border-bottom:1px solid var(--line); gap:14px; flex-wrap:wrap;}
  .cert-item:last-child{border-bottom:none;}
  .cert-name{font-weight:600; font-size:0.98rem;}
  .cert-name a{color:var(--accent);}
  .cert-desc{color:var(--ink-soft); font-size:0.88rem; margin-top:3px;}
  .cert-date{font-family:'IBM Plex Mono',monospace; font-size:0.78rem; color:var(--ink-faint); white-space:nowrap;}

  /* EDUCATION */
  .edu-card{background:var(--surface); border:1px solid var(--line); border-radius:var(--radius); padding:24px 26px; display:flex; justify-content:space-between; flex-wrap:wrap; gap:10px;}
  .edu-card h3{font-size:1.02rem; font-weight:600;}
  .edu-card p{margin:6px 0 0; color:var(--ink-soft); font-size:0.9rem;}
  .edu-date{font-family:'IBM Plex Mono',monospace; font-size:0.8rem; color:var(--ink-faint);}

  /* FOOTER */
  footer{padding:52px 0 64px; border-top:1px solid var(--line); margin-top:20px; position:relative; z-index:1;}
  .footer-inner{display:flex; justify-content:space-between; align-items:flex-end; flex-wrap:wrap; gap:24px;}
  .footer-title{font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:1.5rem;}
  .footer-title .accent-dot{color:var(--accent);}
  .footer-sub{color:var(--ink-soft); font-size:0.92rem; margin-top:6px; max-width:420px;}
  .footer-links{display:flex; gap:22px; flex-wrap:wrap;}
  .footer-links a{font-weight:600; font-size:0.92rem; color:var(--ink);}
  .footer-links a:hover{color:var(--accent);}
  .footer-note{margin-top:38px; font-size:0.78rem; color:var(--ink-faint); font-family:'IBM Plex Mono',monospace;}

  ::selection{background:var(--accent); color:#04211D;}
</style>
</head>
